# Self-Retraining Model Platform — environment template.
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real credentials.

# API key for all write endpoints. Generate with: openssl rand -hex 24
API_KEY=changeme-generate-a-real-key

# Database (host port 5433; 5432 belongs to a native PostgreSQL service)
DATABASE_URL=postgresql+psycopg://mlops:mlops@localhost:5433/mlops

# Object storage (MinIO)
MINIO_ENDPOINT=localhost:9000

# MLflow tracking server
MLFLOW_TRACKING_URI=http://localhost:5000

# Argo Workflows server (self-signed cert; port-forward must be running)
ARGO_URL=https://localhost:2746
